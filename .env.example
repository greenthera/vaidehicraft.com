# Production defaults to https://vaidehicraft.com; no env file is required.
# Optional override for a deliberate future domain change (rebuild afterward):
# NEXT_PUBLIC_SITE_URL=https://vaidehicraft.com
# Server-only alternative (use one override, not both):
# SITE_URL=https://vaidehicraft.com
# Local development and recognised deployment previews remain noindex.

# GitHub Pages production defaults (npm run build:pages / npm run deploy):
# PAGES_ORIGIN=https://vaidehicraft.com
# PAGES_BASE_PATH=
# Leave the base path empty: the production website is at the domain root.
# A CNAME file is generated for a root custom domain.
# The previous staging/subpath build can still be selected explicitly; see docs/github-pages.md.
